# Copy to aircc_job_manager/.env and adjust for your environment.

AIRCC_ALERT_EMAIL=tomerash98@gmail.com

# Email alerts (optional). Leave AIRCC_SMTP_HOST unset to fall back to the
# local mail/mailx command (or skip alerts entirely if neither is available).
# SMTP needs no local mail daemon -- recommended on botero. For Gmail, USER is
# your address and PASS is a 16-char App Password (Google account > Security >
# App passwords), NOT your login password.
# AIRCC_SMTP_HOST=smtp.gmail.com
# AIRCC_SMTP_PORT=587
# AIRCC_SMTP_USER=tomerash98@gmail.com
# AIRCC_SMTP_PASS=your_16_char_app_password
# AIRCC_SMTP_FROM=tomerash98@gmail.com
