# Copy to slurm_job_manager/.env and edit. Only the botero-side monitor needs
# these; the cluster controller reads just SJM_DB (exported by the sbatch).

# Shared-mount SQLite DB, as seen from botero and from a cluster job.
SJM_DB=/home/tomer_a/Documents/ares/slurm_job_manager/jobs.sqlite
SJM_DB_CLUSTER=/home/ashtomer/projects/ares/slurm_job_manager/jobs.sqlite

# SSH alias + cluster paths (unused by the DB-driven monitor, kept for parity).
SJM_SSH_HOST=slurm
SJM_CLUSTER_USER=ashtomer
SJM_CLUSTER_REPO=/home/ashtomer/projects/ares

# Failure escalation.
SJM_ENABLE_FAILURE_ANALYZER=1
SJM_RECOMMENDATIONS_DIR=/home/tomer_a/Documents/ares/slurm_job_manager/recommendations
SJM_ALERT_EMAIL=tomerash98@gmail.com
# SJM_LLM_CMD=codex          # diagnosis CLI for unknown signatures (default codex)
# SJM_SMTP_HOST=smtp.gmail.com
# SJM_SMTP_USER=you@gmail.com
# SJM_SMTP_PASS=app-password
