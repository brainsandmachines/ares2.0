# Copy to orchestrator/.env and adjust for your environment.
# These are the two genuinely environment-specific open items: the shared-mount
# DB path (as seen from botero AND from the cluster) and the ssh alias.

# --- SQLite DB on the shared Slurm mount ---
# Path as seen from BOTERO (orchestrator reads/writes here):
ORCH_DB=/home/tomer_a/Documents/ares/orchestrator/orchestrator.db
# Path as seen from a CLUSTER job (passed to jobs via sbatch --export):
ORCH_DB_CLUSTER=/home/ashtomer/projects/ares/orchestrator/orchestrator.db

# --- SSH / cluster ---
ORCH_SSH_HOST=slurm
ORCH_CLUSTER_USER=ashtomer
ORCH_CLUSTER_REPO=/home/ashtomer/projects/ares
ORCH_LOGS_ROOT=/home/ashtomer/projects/ares/outs

# --- loop timing (change live; daemon restart picks it up) ---
ORCH_INTERVAL_MINUTES=20
ORCH_STALE_HOURS=10

# --- failure analyzer ---
ORCH_ENABLE_FAILURE_ANALYZER=1
ORCH_RECOMMENDATIONS_DIR=/home/tomer_a/Documents/ares/orchestrator/recommendations
ORCH_ALERT_EMAIL=tomerash98@gmail.com
